            },
            ".mbr-author-name": {
              "color": "#000"
            },
            ".JCB": {
              "border": "1px solid #000",
              "padding": "10px",
              "border-radius": "15px"
            },
            "a:link": {
              "color": "#000",
              "background-color": "transparent",
              "text-decoration": "none"
            },
            "a:visited": {
              "color": "#000",
              "background-color": "transparent",
              "text-decoration": "none"
            },
            "a:hover": {
              "color": "#000",
              "background-color": "transparent",
              "text-decoration": "underline"
            },
            "a:active": {
