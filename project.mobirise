  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "SodaTide – Advanced Support for Nerve Health",
        "meta_descr": "SodaTide is an item that focuses on the wellness side, and therefore is positioned in a way that it will fit easily into someone’s daily life. The positioning is likely to attract those who aim to take care of themselves and follow their wellness plans by having healthy eating, drinking, moving and living habits. SodaTide can be positioned as one of the aspects of leading a well-balanced life, but not as a substitute for a good diet or medical care. To learn all the information about its contents and usage, one should read the label on the package.",
        "header_custom": "<meta name=\"keywords\" content=\"prosta defend, prostadefend, prosta defend supplement, prosta defend pills\">\n <meta name=\"author\" content=\"prosta defend\">\n\t\t\n <link rel=\"canonical\" href=\"\" >",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/sodatide-main.webp"
      },
      "components": [
        {
          "_name": "menu2",
          "_sourceTheme": "mobirise5",
